root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.go]
indent_style = tab

[*.py]
indent_size = 4

# Shell and bats use 4 spaces, not the 2-space default above. The large setup
# script and tests/*.bats follow this style. This rule keeps EditorConfig-aware
# editors aligned with the repository.
[*.{sh,bash,bats}]
indent_size = 4

# The setup script embeds heredocs whose content may depend on exact bytes, so
# an editor must not strip trailing whitespace inside them. This mirrors the
# exclusion .pre-commit-config.yaml already applies: its trailing-whitespace and
# end-of-file-fixer hooks run only on md/yaml/yml/json/toml.
[scripts/*.sh]
trim_trailing_whitespace = false
